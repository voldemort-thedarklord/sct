# ==============================================================================
# SMART COMMUNITY HEALTH — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# NOTE: 0 API keys are required to run the application locally!
# - Weather & Precipitation: Uses Open-Meteo (https://api.open-meteo.com) — Keyless
# - Geospatial Map Tiles:    Uses OpenStreetMap / CartoDB DarkMatter — Keyless
# - AI / ML Inference:       Runs locally via Scikit-Learn & XGBoost (.joblib) — Keyless
# - Database (Default):      Uses local SQLite (smart_community_health.db) — Keyless
# ==============================================================================

# 1. SUPABASE CLOUD POSTGRES INTEGRATION
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# 2. DIRECT SQLALCHEMY DATABASE URL (Optional — Defaults to local SQLite synced with Supabase)
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 2. SECONDARY WEATHER TELEMETRY (Optional — Open-Meteo is used automatically without a key)
# If you prefer OpenWeatherMap in addition to Open-Meteo:
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# 3. SMS EARLY WARNING DISPATCH (Optional — For real cellular SMS dispatch to health workers)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_FROM_NUMBER=+1234567890

# 4. EMAIL ALERT DISPATCH (Optional — For automated SMTP email alerts on High/Critical risk)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.org
# SMTP_PASS=your_app_specific_password

# 5. CARTO BASEMAPS API KEY (Optional — For CARTO tile layers without watermark)
# CARTO_API_KEY=your_carto_basemaps_api_key_here

# 6. ALLOWED CORS ORIGINS (Comma-separated)
ALLOWED_ORIGINS=https://smartcommunityht.vercel.app,http://localhost:3000
